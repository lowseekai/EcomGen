# 业务数据目录：保存 SQLite 数据库、上传素材、生成结果和导出文件
# API 与 Worker 必须使用同一个目录
ECOMGEN_DATA_DIR=./data

# Redis 连接地址：BullMQ 队列和事件总线依赖
# API 与 Worker 必须使用同一个 REDIS_URL
REDIS_URL=redis://127.0.0.1:6379

# 队列名称：API 入队和 Worker 消费通过该名称关联，两端必须一致
ECOMGEN_QUEUE_NAME=ecomgen

# 主密钥：Base64 编码的 32 字节密钥，用于 Provider API Key 等敏感数据加密
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# API 与 Worker 必须使用同一个 ECOMGEN_MASTER_KEY；不要提交真实密钥
ECOMGEN_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# API 监听地址与端口
HOST=127.0.0.1
PORT=8787

# CORS 来源白名单：逗号分隔的完整来源（scheme://host[:port]）
# 未设置时默认只允许本机 web dev server（http://localhost:5173、http://127.0.0.1:5173）
# 远程/容器部署必须显式设置前端实际来源；通配符与非法来源会在启动时报错
# ECOMGEN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Worker 并发数：同时处理的生图/导出任务数量，按本机资源和 Provider 限流调整
WORKER_CONCURRENCY=2

# 单个任务的墙钟上限（毫秒），默认 15 分钟。
# Node 的 fetch 没有默认超时：Provider 挂起（连上但不回）时任务会永久 RUNNING，
# 占死并发槽位、积分一直挂着。超时后按失败处理（可重试，最终退款）。
# WORKER_JOB_TIMEOUT_MS=900000

# 首次启动创建的站长账号。只在 users 表为空时生效，之后修改这里不会改密码。
# 不填密码时启动日志会打印一次随机密码，请登录后立即修改。
# ECOMGEN_BOOTSTRAP_EMAIL=owner@ecomgen.local
# ECOMGEN_BOOTSTRAP_PASSWORD=

# 生产走 HTTPS 时必须置为 true，否则会话 cookie 不带 Secure 标记。
# ECOMGEN_SECURE_COOKIES=false
