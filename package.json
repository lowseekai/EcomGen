{
  "name": "ecomgen",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently -n api,worker,web -c cyan,magenta,green \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:worker": "pnpm --filter @ecomgen/worker dev",
    "dev:web": "pnpm --filter @ecomgen/web dev",
    "test": "pnpm -r test",
    "lint": "eslint apps packages",
    "lint:fix": "eslint apps packages --fix",
    "test:affected": "node scripts/affected.mjs test",
    "build:affected": "node scripts/affected.mjs build",
    "test:e2e:mock": "node scripts/e2e-mock.mjs",
    "rehearse:restore": "node scripts/rehearse-restore.mjs",
    "test:contracts": "pnpm --filter @ecomgen/contracts test",
    "gen:openapi": "pnpm --filter @ecomgen/contracts build && node scripts/generate-openapi.mjs",
    "gen:check": "pnpm --filter @ecomgen/contracts build && node scripts/generate-openapi.mjs --check",
    "verify-contracts": "pnpm gen:check && pnpm lint:openapi && pnpm --filter @ecomgen/contracts test",
    "lint:openapi": "npx --yes @redocly/cli lint openapi.yaml --skip-rule operation-summary --skip-rule operation-4xx-response --skip-rule info-license --skip-rule no-server-example.com --skip-rule no-unused-components",
    "smoke:live": "node scripts/smoke-live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "concurrently": "^9.2.0",
    "eslint": "^10.14.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.1.2",
    "yaml": "^2.9.0"
  }
}
